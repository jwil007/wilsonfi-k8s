#!/bin/sh
# Refuse to commit a Kubernetes Secret that isn't SOPS-encrypted.
# Enable once per clone: git config core.hooksPath .githooks
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.yaml' '*.yml'); do
  content=$(git show ":$f")
  echo "$content" | grep -qE '^kind:[[:space:]]*Secret' || continue
  if ! echo "$content" | grep -q '^sops:'; then
    echo "pre-commit: $f is a Secret but is NOT sops-encrypted." >&2
    echo "            run: sops -e -i $f && git add $f" >&2
    fail=1
  fi
done
exit $fail
